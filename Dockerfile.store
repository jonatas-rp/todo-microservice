# syntax=docker/dockerfile:1

FROM golang:1.27-bookworm AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/store-server ./cmd/store-server

FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app

COPY --from=build /out/store-server /app/store-server

ENV GRPC_ADDR=:50051
ENV DB_PATH=/data/todos.db
ENV LOG_LEVEL=INFO

EXPOSE 50051
USER nonroot:nonroot
ENTRYPOINT ["/app/store-server"]
